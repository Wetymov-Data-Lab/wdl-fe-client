# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

SERVICE_NAME="wdl-fe-client"
APP_ENV="development"
APP_VERSION="1.0.0"
APP_HOST="0.0.0.0"
APP_PORT="3000"
APP_URL="http://localhost:3000"
API_VERSION="1"

# ---------------------------------------------------------------------------
# WDL Core API
# ---------------------------------------------------------------------------

CORE_API_URL="http://localhost:8000"
CORE_API_TIMEOUT_MS="10000"
CORE_API_RETRY_COUNT="1"
DEVELOPMENT_AUTHOR_ID="00000000-0000-4000-8000-000000000001"

# ---------------------------------------------------------------------------
# Identity service
# ---------------------------------------------------------------------------

AUTH_ENABLED="true"
IDENTITY_SERVICE_URL="http://localhost:8002"
IDENTITY_API_VERSION="1"

# ---------------------------------------------------------------------------
# Diagram editor
# ---------------------------------------------------------------------------

DIAGRAM_GRID_SIZE="20"
DIAGRAM_SNAP_TO_GRID="true"
DIAGRAM_SHOW_RELATIONSHIP_LABELS="true"
DIAGRAM_MIN_ZOOM="0.25"
DIAGRAM_MAX_ZOOM="1.8"
